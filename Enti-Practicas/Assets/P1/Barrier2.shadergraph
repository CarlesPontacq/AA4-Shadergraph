    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "41902e13c9534201b8c97dd8906ebc1c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "HexGridFunction_float (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1919.999755859375,
            "y": -230.39999389648438,
            "width": 281.5999755859375,
            "height": 325.6000061035156
        }
    },
    "m_Slots": [
        {
            "m_Id": "b359992c846741dea778c74a41513fbf"
        },
        {
            "m_Id": "420027ea5b524e5d8a9f07c419b24f2d"
        },
        {
            "m_Id": "39a357377a254bb7a13d5864a5ced4ae"
        },
        {
            "m_Id": "2e6f702ef7d74d52999ac32909e4fd16"
        },
        {
            "m_Id": "c93d87c2f5154ba78424b50f1d13dc6b"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HexGridFunction_float",
    "m_FunctionSource": "1ff6016c1ae13fe4ebb99f699555c06e",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 scrolledUV = UV + float2(0, _Time.y * ScrollSpeed);\n\nfloat2 hexUV = scrolledUV * HexSize;\n\nconst float sqrt3 = 1.7320508;\nfloat2 s = float2(1, sqrt3);\n\nfloat4 hexCenter = round(float4(hexUV, hexUV - float2(0.5, 1.0)) / s.xyxy);\nfloat4 offset = float4(hexUV - hexCenter.xy * s, hexUV - (hexCenter.zw + 0.5) * s);\n\nfloat isStaggered = dot(offset.xy, offset.xy) < dot(offset.zw, offset.zw);\n\nfloat2 closestOffset = isStaggered ? offset.xy : offset.zw;\nHexDistance = length(closestOffset);\n\nHexID = isStaggered ? hexCenter.xy : hexCenter.zw;"
}

