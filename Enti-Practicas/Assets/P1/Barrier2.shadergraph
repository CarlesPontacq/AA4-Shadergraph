    },
    "m_Name": "DepthIntersectionFunction (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2595.050048828125,
            "y": 1010.0194702148438,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "5802dba3c56d4f8b93596d8e9af4b51a"
        },
        {
            "m_Id": "bb47bc97a2d54336a8c5aaf5119e8d7d"
        },
        {
            "m_Id": "844a95584a2d4328b8243af5b68f91ea"
        },
        {
            "m_Id": "fa9a07f9abad41d287a16cc3fc34b691"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DepthIntersectionFunction",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float sceneDepth = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(ScreenPosition.xy), _ZBufferParams);\r\nfloat currentDepth = ScreenPosition.w;\r\n    \nfloat depthDiff = sceneDepth - currentDepth;\n\nfloat glowFactor = saturate(depthDiff / DepthDistance);\r\n    \r\nglowFactor = 1.0 - glowFactor;\r\n    \r\nIntersectionGlow = glowFactor * DepthIntensity;"
}

