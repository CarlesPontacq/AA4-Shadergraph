        "m_Id": ""
    },
    "m_Name": "FresnelFunction (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -6543.99951171875,
            "y": -40.00004196166992,
