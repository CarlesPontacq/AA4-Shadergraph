{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a34805052b29407daa38f25566345e13",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "DepthIntersectionFunction (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -6237.59912109375,
            "y": -512.0001220703125,
            "width": 306.3994140625,
            "height": 349.6000671386719
        }
    },
    "m_Slots": [
        {
            "m_Id": "5802dba3c56d4f8b93596d8e9af4b51a"
        },
        {
            "m_Id": "bb47bc97a2d54336a8c5aaf5119e8d7d"
        },
        {
            "m_Id": "844a95584a2d4328b8243af5b68f91ea"
        },
        {
            "m_Id": "e3094108881f4939b164797b336c07f7"
        },
        {
            "m_Id": "fa9a07f9abad41d287a16cc3fc34b691"
        },
        {
            "m_Id": "3004bc2f37b0444e93f4d1388af2850d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DepthIntersectionFunction",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float sceneDepth = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(ScreenPosition.xy), _ZBufferParams);\r\nfloat currentDepth = ScreenPosition.w;\r\n    \r\nfloat depthDiff = sceneDepth - currentDepth;\r\n    \r\nfloat glowFactor = saturate(depthDiff / DepthDistance);\r\nglowFactor = 1.0 - glowFactor;\r\nIntersectionGlow = glowFactor * DepthIntensity;\r\n\r\nfloat cutoutRaw = saturate(-depthDiff / DepthDistance);\r\n    \r\n\r\nCutoutAlpha = pow(cutoutRaw, CutoutSoftness);\r\n    \r\n\r\n//CutoutAlpha = 1.0 - cutoutRaw;"
}

