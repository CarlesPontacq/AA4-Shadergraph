{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "463f3a6968ce482c90edc530a4d3ea39",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "IntersectionGlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2499.199951171875,
            "y": -1276.800048828125,
            "width": 255.199951171875,
            "height": 373.599853515625
        }
    },
    "m_Slots": [
        {
            "m_Id": "81ab48f2e6f0446d9f8f024d95aea480"
        },
        {
            "m_Id": "0f04da27a51a4e6f99ae4ffaa8c29982"
        },
        {
            "m_Id": "16544708d15d48e18ba2f20b2200d15e"
        },
        {
            "m_Id": "5db634fe6380436fae8e3acd5adb6ed8"
        },
        {
            "m_Id": "8a5a0cee14d347cc91a121ce2e7a79c9"
        },
        {
            "m_Id": "9e73ed7ddeab418ab3ed16b18dffd60f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "IntersectionGlow",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "    #if defined(SHADERGRAPH_PREVIEW)\r\n        GlowAmount = 0.0;\r\n        return;\r\n    #endif\r\n    \r\n    // Get screen UVs\r\n    float2 screenUV = ScreenPos.xy / ScreenPos.w;\r\n    #if defined(UNITY_UV_STARTS_AT_TOP)\r\n        screenUV.y = 1.0 - screenUV.y;\r\n    #endif\r\n    \r\n    // Linearize scene depth\r\n    float sceneDepthLinear = LinearEyeDepth(SceneDepthRaw, _ZBufferParams);\r\n    \r\n    // ============================================\r\n    // STATIC DEPTH CALCULATION (Camera independent)\r\n    // ============================================\r\n    \r\n    // Method: Project world position to view space\r\n    float4 viewPos = mul(UNITY_MATRIX_V, float4(WorldPos, 1.0));\r\n    float objectDepth = -viewPos.z;\r\n    \r\n    // Calculate depth difference\r\n    float depthDiff = abs(sceneDepthLinear - objectDepth);\r\n    \r\n    // Edge detection with width control\r\n    float glowRaw = 1.0 - smoothstep(GlowWidth * 0.3, GlowWidth, depthDiff);\r\n    \r\n    // Apply intensity\r\n    GlowAmount = saturate(glowRaw * GlowIntensity);"
}

