            "m_Id": "987612d2a54a42cfa6a0c8ca020bb0fc"
        },
        {
            "m_Id": "cfaa4a6ffcfc4e26b1b027aab1b8a854"
        },
        {
            "m_Id": "864dd2445ad04c0997998eec29018ec8"
        },
        {
            "m_Id": "8a417fd721ae44699911742378bebddc"
        },
        {
            "m_Id": "2e9ecb536da344faa615ff519ff1894d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FresnelFunction",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\r\nfloat3 normalizedNormal = normalize(WorldNormal);\r\nfloat3 normalizedView = normalize(ViewDirection);\r\n\nfloat dotNV = abs(dot(normalizedNormal, normalizedView));\r\n    \r\nfloat fresnelRaw = 1.0 - dotNV;\nFresnel = pow(fresnelRaw, Power) * Intensity;"
}

